# Copy to .env and replace the placeholders before running Kamal.
# .env is ignored by Git. Existing exported variables take precedence.
RAINGAUGE_KAMAL_SERVER_HOST='<server-ip-or-ssh-hostname>'
RAINGAUGE_KAMAL_PROXY_HOST='rainfall.example.com'
KAMAL_REGISTRY_USERNAME='<github-user>'
KAMAL_REGISTRY_PASSWORD='<github-token-with-package-access>'
RAINGAUGE_ADMIN_USERNAME='<administrator-username>'
# Keep the encoded password single-quoted to preserve literal dollar signs.
RAINGAUGE_ADMIN_PASSWORD='<encoded-spring-security-password>'
# Local deployments use your SSH configuration or agent.
# RAINGAUGE_KAMAL_SSH_PRIVATE_KEY is a GitHub Actions secret, not a local .env setting.
